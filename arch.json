  "architectures": {
    "now": {
      "label": "現在",
      "caption": "Coordinator 統籌派工；Worker A／B／C 執行；Reviewer 審查；watcher 回報喚醒。",
      "event_limit": 4,
      "layers": [
        ["user", "entry", "watcher"],
        ["coordinator"],
        ["worker-a", "worker-b", "worker-c", "reviewer"]
      ],
      "nodes": {
        "user": {"label": "Operator", "abbr": "Operator", "model": "Human", "role": "需求與驗收", "kind": "actor"},
        "entry": {"label": "Mobile entry", "abbr": "entry", "model": "Mobile", "role": "手機入口", "kind": "support", "match_keywords": ["entry"]},
        "watcher": {"label": "watcher.sh", "abbr": "watcher", "model": "macOS", "role": "任務結束叫醒協調者", "kind": "support", "match_keywords": ["watcher"]},
        "coordinator": {"label": "Coordinator", "abbr": "Coord", "model": "model-x", "role": "規劃、派工、驗收", "kind": "coordinator", "match_keywords": ["coordinator"]},
        "worker-a": {"label": "Worker A", "abbr": "Worker A", "model": "model-x", "role": "實作與修正", "kind": "worker", "match_keywords": ["worker-a", "worker a"]},
        "worker-b": {"label": "Worker B", "abbr": "Worker B", "model": "model-y", "role": "主要實作與整合", "kind": "worker", "match_keywords": ["worker-b", "worker b"]},
        "worker-c": {"label": "Worker C", "abbr": "Worker C", "model": "model-z", "role": "調查與修正", "kind": "worker", "match_keywords": ["worker-c", "worker c"]},
        "reviewer": {"label": "Reviewer", "abbr": "Reviewer", "model": "model-w", "role": "獨立審查", "kind": "worker", "match_keywords": ["reviewer"]}
      },
      "edges": [
        ["user", "coordinator", "需求"],
        ["entry", "coordinator", "手機派工"],
        ["watcher", "coordinator", "完成喚醒"],
        ["coordinator", "worker-a", "派工"],
        ["coordinator", "worker-b", "派工"],
        ["coordinator", "worker-c", "派工"],
        ["coordinator", "reviewer", "派工"],
        ["worker-a", "coordinator", "回報"],
        ["worker-b", "coordinator", "回報"],
        ["worker-c", "coordinator", "回報"],
        ["reviewer", "coordinator", "回報"]
      ]
    },
    "future": {
      "label": "未來",
      "caption": "Planner 規劃與派工，worker 回報後由 Reviewer 審查，再回報 Operator。",
      "event_limit": 4,
      "layers": [
        ["user", "entry"],
        ["planner"],
        ["worker-a", "worker-c", "worker-d"],
        ["reviewer"],
        ["report"]
      ],
      "nodes": {
        "user": {"label": "Operator", "abbr": "Operator", "model": "Human", "role": "需求與驗收", "kind": "actor"},
        "entry": {"label": "Mobile entry", "abbr": "entry", "model": "Mobile", "role": "手機入口", "kind": "support", "match_keywords": ["entry"]},
        "planner": {"label": "Planner", "abbr": "Planner", "model": "model-x", "role": "規劃與派工", "kind": "coordinator", "match_keywords": ["planner"]},
        "worker-a": {"label": "Worker A", "abbr": "Worker A", "model": "model-x", "role": "實作與修正", "kind": "worker", "match_keywords": ["worker-a", "worker a"]},
        "worker-c": {"label": "Worker C", "abbr": "Worker C", "model": "model-z", "role": "調查與修正", "kind": "worker", "match_keywords": ["worker-c", "worker c"]},
        "worker-d": {"label": "Worker D", "abbr": "Worker D", "model": "model-v", "role": "獨立實作", "kind": "worker", "match_keywords": ["worker-d", "worker d"]},
        "reviewer": {"label": "Reviewer", "abbr": "Reviewer", "model": "model-w", "role": "獨立審查", "kind": "coordinator", "match_keywords": ["reviewer"]},
        "report": {"label": "回報 Operator", "abbr": "回報", "model": "Human", "role": "驗收與決策", "kind": "actor"}
      },
      "edges": [
        ["user", "planner", "需求"],
        ["entry", "planner", "手機入口"],
        ["planner", "worker-a", "派工"],
        ["planner", "worker-c", "派工"],
        ["planner", "worker-d", "派工"],
        ["worker-a", "reviewer", "回報"],
        ["worker-c", "reviewer", "回報"],
        ["worker-d", "reviewer", "回報"],
        ["reviewer", "report", "結果"]
      ]
    }
